{
 "version": 1,
 "description": "CareCompanion build board",
 "project": {
  "owner": "MAOFILHO",
  "title": "CareCompanion build board",
  "number": 4
 },
 "worker_backend": "workflow",
 "host": "claude",
 "model_tier": "medium",
 "target": {
  "type": "repo",
  "url": null
 },
 "repo": {
  "path": ".",
  "remote": "https://github.com/MAOFILHO/Azure-HealthCare-Agentic-AI"
 },
 "base_branch": "staging",
 "timezone": "America/Toronto",
 "columns": [
  "Backlog",
  "Ready",
  "Building",
  "QA",
  "Review",
  "Blocked",
  "Done"
 ],
 "labels": [
  "qa",
  "bug",
  "feature"
 ],
 "paths": {
  "project_md": "docs/super-board/PROJECT.md",
  "pre_flight_md": "docs/super-board/pre-flight.md",
  "runs_dir": "docs/super-board/runs"
 },
 "human_approves_merge": false,
 "merge_policy": {
  "default": "auto",
  "auto_max_lines": 400,
  "always_human": {
   "money": {
    "labels": [
     "money",
     "payments",
     "billing",
     "pricing"
    ],
    "paths": [
     "**/billing/**",
     "**/payments/**"
    ],
    "keywords": [
     "stripe.",
     "payment_intent",
     "invoice.create"
    ]
   },
   "auth": {
    "labels": [
     "auth",
     "security"
    ],
    "paths": [
     "**/auth/**",
     "**/authz/**",
     "**/permissions/**"
    ],
    "keywords": [
     "jwt.sign",
     "bcrypt",
     "password_hash",
     "service_role"
    ]
   },
   "schema": {
    "labels": [
     "schema",
     "destructive"
    ],
    "paths": [],
    "keywords": [
     "drop table",
     "drop column",
     "truncate table"
    ]
   }
  },
  "allow_auto_on_production": false
 },
 "migrations": {
  "globs": [
   "**/migrations/*.sql",
   "alembic/versions/**"
  ],
  "allowed_envs": [
   "test",
   "staging"
  ],
  "target_env": "staging",
  "commands": {},
  "checks": {},
  "human_steps": []
 },
 "verify_commands": [
  "python3 -m compileall -q src"
 ],
 "collect": {
  "sources": [
   "github",
   "prs",
   "architecture"
  ],
  "window_days": 14,
  "prs": {
   "max_prs": 200
  },
  "architecture": {
   "max_findings": 5
  }
 },
 "notifications": {
  "channel": "session",
  "chat_id": null,
  "bot_identity": "MAOFILHO"
 }
}